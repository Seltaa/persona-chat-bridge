{
  "manifest_version": 3,
  "name": "Persona Chat Bridge",
  "version": "0.1.0",
  "description": "Connects visible ChatGPT reply activity to the local Persona desktop avatar.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dom-adapter.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Persona Chat Bridge",
    "default_popup": "popup.html"
  }
}
